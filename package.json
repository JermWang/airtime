{
  "name": "airtime",
  "version": "0.1.0",
  "private": true,
  "description": "AIRTIME — browser-native linear television + programmable billboard network, built on Robinhood Chain.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --cache",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/reset.ts",
    "studio:build": "tsx scripts/build-studio-gltf.ts",
    "chain:local": "anvil --chain-id 31337 --block-time 1",
    "contract:build": "cd contracts && forge build",
    "contract:test": "cd contracts && forge test -vv",
    "contract:deploy:local": "tsx scripts/deploy-local.ts",
    "contract:deploy:testnet": "cd contracts && forge script script/Deploy.s.sol:Deploy --rpc-url robinhood_testnet --broadcast",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "worker": "tsx scripts/worker.ts",
    "art:build": "tsx scripts/build-panel-art.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@react-three/postprocessing": "^3.1.1",
    "@tanstack/react-query": "^5.102.8",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.2",
    "file-type": "^22.0.2",
    "hls.js": "^1.7.2",
    "jose": "^6.2.11",
    "motion": "^13.2.0",
    "next": "^16.3.4",
    "pg": "^8.23.0",
    "postprocessing": "^6.39.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.4",
    "three": "^0.185.1",
    "viem": "^2.56.3",
    "wagmi": "^3.7.7",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.185.4",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.0",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@11.9.0"
}
