# ---------------------------------------------------------------------------
# AIRTIME environment
# Copy to .env.local for development. Never commit real secrets.
# ---------------------------------------------------------------------------

# Postgres connection. Leave empty in development to use the embedded
# PGlite database stored in ./.pglite (real Postgres semantics, zero setup).
DATABASE_URL=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# WalletConnect Cloud project id (https://cloud.reown.com). Optional in dev;
# injected wallets and the local dev wallet work without it.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Robinhood Chain RPC endpoints used by the SERVER (quote verification, event
# reading). Use a dedicated provider (e.g. Alchemy) in production; the public
# endpoints below are fallbacks and must not be hammered.
ROBINHOOD_MAINNET_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com

# Optional browser-side RPC override (defaults to the public endpoint for the
# selected chain). Wallets use their own RPC for transactions.
NEXT_PUBLIC_RPC_URL=

# local | testnet | mainnet
NEXT_PUBLIC_CHAIN_ENV=local

# Backend quote signer. This key ONLY signs EIP-712 quotes; it never holds funds.
# Its address must match `quoteSigner` on the deployed AirtimePayments contract.
AIRTIME_QUOTE_SIGNER_PRIVATE_KEY=

# Deployed AirtimePayments contract for the selected chain.
NEXT_PUBLIC_AIRTIME_PAYMENT_CONTRACT=
# Block the contract was deployed at (lets the payment watcher skip history).
AIRTIME_PAYMENT_CONTRACT_DEPLOY_BLOCK=0
# Confirmations required before a payment is considered final.
AIRTIME_PAYMENT_CONFIRMATIONS=1

# Treasury that receives payments (set on the contract, shown in the UI).
TREASURY_ADDRESS=

# Session secrets (32+ random bytes, hex or base64).
AIRTIME_SESSION_SECRET=
AIRTIME_UPLOAD_SECRET=

# Initial admin for /control-room (created on first boot if the table is empty).
ADMIN_EMAIL=admin@airtime.local
ADMIN_PASSWORD=

# Storage provider: local | s3
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./storage
# S3-compatible settings (only when STORAGE_PROVIDER=s3)
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=
STORAGE_S3_ENDPOINT=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_BASE_URL=

# Media provider: local | (future: mux, cloudflare-stream)
MEDIA_PROVIDER=local
# Extra origins allowed to serve video/images (CSP media-src / img-src), comma separated.
NEXT_PUBLIC_MEDIA_ORIGINS=https://test-streams.mux.dev,https://stream.mux.com,https://*.mux.com,https://interactive-examples.mdn.mozilla.net,https://upload.wikimedia.org

# The treasury allocation (share of income used to buy Anduril pre-stock) and the
# operator ledger are configured in the control room, not here.

# Seed realistic DEV DATA on boot when the database is empty (never in production).
AIRTIME_SEED_DEV_DATA=true

# Allow operators to move the station simulation clock outside development
# (staging/testnet only; never enabled on mainnet).
AIRTIME_ALLOW_SIM_CLOCK=false

# Optional: verified USDG contract address on the selected chain. Leave empty
# until you have the real deployed address; the asset is not selectable otherwise.
NEXT_PUBLIC_USDG_ADDRESS=

# Optional explorer override for transaction links.
NEXT_PUBLIC_EXPLORER_URL=

# Dev/E2E only: a local wallet (anvil account) injected as a connector so the
# purchase flow can be exercised without a browser extension. NEVER set in prod.
NEXT_PUBLIC_DEV_WALLET_PRIVATE_KEY=
