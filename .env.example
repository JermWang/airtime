# Application
NEXT_PUBLIC_APP_URL=http://localhost:3200
DATABASE_URL=
# Solana: devnet (default), mainnet, or local.
NEXT_PUBLIC_SOLANA_NETWORK=devnet
# Server-only RPC; use a provider for launch. Never expose its credentials in NEXT_PUBLIC_*.
SOLANA_RPC_URL=https://api.devnet.solana.com
# Required to enable SOL purchases. A real Solana public key, never a private key.
SOLANA_TREASURY_ADDRESS=
# Set only when the token is issued. AIRTIME prices and payments use native SOL.
NEXT_PUBLIC_SOLANA_TOKEN_MINT=
NEXT_PUBLIC_AIRTIME_TOKEN_DECIMALS=9
AIRTIME_SESSION_SECRET=
AIRTIME_UPLOAD_SECRET=
ADMIN_EMAIL=admin@airtime.local
ADMIN_PASSWORD=
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./storage
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=
STORAGE_S3_ENDPOINT=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_BASE_URL=
MEDIA_PROVIDER=local
NEXT_PUBLIC_MEDIA_ORIGINS=https://test-streams.mux.dev,https://interactive-examples.mdn.mozilla.net,https://upload.wikimedia.org
AIRTIME_SEED_DEV_DATA=false
AIRTIME_MIGRATE_ON_BOOT=true
AIRTIME_DISABLE_TICKER=false
AIRTIME_ALLOW_SIM_CLOCK=false
AIRTIME_CRON_SECRET=
